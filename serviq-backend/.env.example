# Serviq Backend Environment Configuration Example (NO REAL SECRETS)

# Server
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-domain.vercel.app

# Database (PostgreSQL with PostGIS)
# Supabase pooler / direct connection:
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Redis Cache & Queues (Optional in dev if mock is used)
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_ACCESS_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_at_least_32_characters_long
JWT_REFRESH_EXPIRES_IN=30d

# Job Verification HMAC Secret
START_CODE_SECRET=your_hmac_start_code_secret_key_at_least_16_chars

# SMS Gateway (Development Mock Mode: true logs OTP to server console)
SMS_DEV_MOCK_MODE=true
SMS_GATEWAY_API_KEY=

# Optional Wispr Flow Voice Integration
WISPR_API_KEY=

# Configurable Business Rules
COMMISSION_LABOR_RATE_PCT=10
CANCEL_TRIP_FEE_AMOUNT=100
CANCEL_GRACE_PERIOD_MINS=5
CANCEL_WORKER_SHARE_PCT=85
CANCEL_PLATFORM_SHARE_PCT=15
WALLET_MAX_NEGATIVE_LIMIT=-1500
MAX_NEGOTIATION_ROUNDS=2
OFFER_EXPIRY_MINS=15
DEFAULT_SEARCH_RADIUS_KM=10
