# Serviq Backend Environment Configuration

# Server
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL with PostGIS)
# For local: postgresql://serviq_user:serviq_password@localhost:5433/serviq_dev
# For Supabase: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://serviq_user:serviq_password@localhost:5433/serviq_dev

# Redis Cache & Queues
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_ACCESS_SECRET=serviq_dev_super_secret_access_jwt_key_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=serviq_dev_super_secret_refresh_jwt_key_at_least_32_chars
JWT_REFRESH_EXPIRES_IN=30d

# SMS Gateway (Development Mock Mode: true logs OTP to server console)
SMS_DEV_MOCK_MODE=true
SMS_GATEWAY_API_KEY=

# Configurable Business Rules
COMMISSION_LABOR_RATE_PCT=10
CANCEL_TRIP_FEE_AMOUNT=100
CANCEL_GRACE_PERIOD_MINS=5
CANCEL_WORKER_SHARE_PCT=85
CANCEL_PLATFORM_SHARE_PCT=15
WALLET_MAX_NEGATIVE_LIMIT=-1500
MAX_NEGOTIATION_ROUNDS=2
OFFER_EXPIRY_MINS=15
DEFAULT_SEARCH_RADIUS_KM=10
